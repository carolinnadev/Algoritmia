Algoritmo AreaRectangulo
    Definir base, altura, area Como Real
    
    Escribir "Ingrese la base del rectángulo:"
    Leer base
    
    Escribir "Ingrese la altura del rectángulo:"
    Leer altura
    
    area <- base * altura
    
    Escribir "El área del rectángulo es: ", area
FinAlgoritmo


